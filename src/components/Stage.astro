---
// Computer + telefono sovrapposti: il sito scorre dentro entrambi mentre si scorre la pagina.
import BrowserMockup from './BrowserMockup.astro';
import PhoneMockup from './PhoneMockup.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  shot: ImageMetadata;
  shotMobile?: ImageMetadata;
  domain: string;
  title: string;
  eager?: boolean;
  /** lato su cui sporge il telefono */
  phoneSide?: 'left' | 'right';
}
const { shot, shotMobile, domain, title, eager, phoneSide = 'left' } = Astro.props;
---

<div class:list={['stage', `phone-${phoneSide}`, { 'has-phone': !!shotMobile }]} data-scrub-stage>
  <div class="desk">
    <BrowserMockup shot={shot} domain={domain} alt={`${title} — ${domain}`} eager={eager} />
  </div>
  {
    shotMobile && (
      <div class="mobile" data-scrub-phone>
        <PhoneMockup shot={shotMobile} alt={`${title} — mobile`} />
      </div>
    )
  }
</div>

<style>
  /* entrata in prospettiva e parallasse del telefono: le trasformazioni le scrive scripts/scrub.ts */
  .stage {
    position: relative;
    transform-origin: 50% 100%;
    will-change: transform;
  }
  .has-phone.phone-left .desk {
    margin-left: 9%;
  }
  .has-phone.phone-right .desk {
    margin-right: 9%;
  }
  .mobile {
    position: absolute;
    bottom: -9%;
    width: 21%;
    min-width: 110px;
    will-change: transform;
  }
  .phone-left .mobile {
    left: 0;
  }
  .phone-right .mobile {
    right: 0;
  }
</style>
