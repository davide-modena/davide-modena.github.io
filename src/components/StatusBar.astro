---
interface Props {
  path: string;
}
const { path } = Astro.props;
---

<div class="statusbar mono" aria-hidden="true">
  <div class="progress"></div>
  <div class="frame inner">
    <span class="prompt">❯</span>
    <span class="path" data-default={path}>{path}</span><span class="caret"></span>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('.statusbar')!;
  const pathEl = bar.querySelector<HTMLElement>('.path')!;
  const progress = bar.querySelector<HTMLElement>('.progress')!;
  const fallback = pathEl.dataset.default ?? '~';
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];

  let shown = fallback;
  function show(next: string) {
    if (next === shown) return;
    shown = next;
    pathEl.textContent = next;
    pathEl.classList.remove('flash');
    void pathEl.offsetWidth;
    pathEl.classList.add('flash');
  }

  // la sezione "attiva" è l'ultima il cui bordo alto ha superato il 40% dello schermo
  function update() {
    const line = innerHeight * 0.4;
    let current = fallback;
    for (const s of sections) if (s.getBoundingClientRect().top < line) current = s.dataset.section!;
    show(current);
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    document.documentElement.classList.toggle('scrolled', scrollY > 8);
  }
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
</script>

<style>
  .statusbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--status-h);
    z-index: 60;
    background: var(--bg);
    border-top: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--fg-3);
  }
  .progress {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .prompt {
    color: var(--accent);
  }
  .path {
    color: var(--fg-2);
  }
  .path:global(.flash) {
    animation: flash 0.5s steps(4);
  }
  @keyframes flash {
    0% {
      opacity: 0.2;
    }
  }
  .caret {
    width: 6px;
    height: 12px;
    background: var(--fg-3);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
