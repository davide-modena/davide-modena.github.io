---
// Il widget quadrato (2×2) della home di Android ("treno seguito live") ricostruito in HTML: stazione, minuti alla
// fermata seguita, ora dell'ultimo aggiornamento, ritardo e il treno (col muso a sinistra se è partito, a destra se
// è fermo). Misure e colori sono quelli di TrainWidget.kt nella versione compatta (nomi lunghi → sigla); segue il
// tema del sito; i dati seguono il viaggio finto Trento → Verona.
import headImg from '../assets/projects/trenitardo/hero/train-head.webp';
import tailImg from '../assets/projects/trenitardo/hero/train-tail.webp';
import { TRAIN_NUMBER } from '../scripts/trenSim';
---

<figure class="hw" data-train-widget>
  <div class="wall">
    <div class="widget" aria-hidden="true">
      <div class="l1" data-l1>{TRAIN_NUMBER} · Fermo a</div>
      <div class="l2" data-station>Trento</div>
      <div class="l3" data-target>→ VRNP · 60'</div>
      <div class="row">
        <div class="clock" data-clock>16:40</div>
        <div class="del">
          <div class="dl">Ritardo</div>
          <div class="dv" data-delay>+5'</div>
        </div>
      </div>
      <div class="grow"></div>
      <div class="trainbox">
        <img class="head" src={headImg.src} alt="" width={headImg.width} height={headImg.height} data-head hidden />
        <img class="tail" src={tailImg.src} alt="" width={tailImg.width} height={tailImg.height} data-tail />
      </div>
    </div>
  </div>
  <figcaption class="mono">Ricostruzione del widget: nella home di Android si aggiorna ogni pochi minuti.</figcaption>
</figure>

<style>
  .hw {
    --w-bg: #1b1b1b;
    --w-fg: #fff;
    --w-mut: #8f8f8f;
    --w-mut2: #b9b9bd;
    --w-train: none;
    display: grid;
    justify-items: center;
    gap: 12px;
    margin: 0;
  }
  :global(:root[data-theme='light']) .hw {
    --w-bg: #f6f6f6;
    --w-fg: #111;
    --w-mut: #6f6f6f;
    --w-mut2: #4b4b4f;
    --w-train: invert(1);
  }
  .wall {
    width: 100%;
    display: grid;
    place-items: center;
    padding: 28px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background:
      radial-gradient(70% 90% at 25% 20%, #2c3350, transparent 70%),
      radial-gradient(60% 80% at 80% 90%, #4a2b3a, transparent 70%),
      #14161f;
  }
  :global(:root[data-theme='light']) .wall {
    background:
      radial-gradient(70% 90% at 25% 20%, #cdd6f5, transparent 70%),
      radial-gradient(60% 80% at 80% 90%, #f3d5df, transparent 70%),
      #e8eaf3;
  }
  .widget {
    width: 164px;
    height: 164px;
    display: flex;
    flex-direction: column;
    padding: 12px;
    border-radius: 20px;
    background: var(--w-bg);
    color: var(--w-fg);
    font-family: Roboto, 'Google Sans', system-ui, sans-serif;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }
  .widget > * {
    flex: none;
  }
  .widget > .grow {
    flex: 1 1 0;
    min-height: 4px;
  }
  .l1 {
    font-size: 10px;
    color: var(--w-mut);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .l2 {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .l3 {
    font-size: 11px;
    color: var(--w-mut2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
  }
  .clock {
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }
  .del {
    text-align: right;
  }
  .dl {
    font-size: 9px;
    color: var(--w-mut);
  }
  .dv {
    font-size: 18px;
    font-weight: 700;
    color: #d71921;
  }
  .dv.ok {
    color: #28a745;
  }
  .trainbox {
    display: grid;
    place-items: center;
    height: 26px;
    padding: 0 6px;
  }
  .trainbox img {
    display: block;
    height: 26px;
    width: auto;
    max-width: 100%;
    border: 0;
    border-radius: 0;
    filter: var(--w-train);
  }
  .trainbox img[hidden] {
    display: none;
  }
  figcaption {
    font-size: 12px;
    color: var(--fg-3);
    text-align: center;
  }
</style>

<script>
  import { state, STOPS, DEST, TRAIN_NUMBER, sigla } from '../scripts/trenSim';
  import { reducedMotion } from '../scripts/glyph';

  // widget stretto: i nomi lunghi diventano sigla, come nell'app
  const fit = (s: string) => (s.length > 11 ? sigla(s) : s);

  document.querySelectorAll<HTMLElement>('[data-train-widget]').forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const l1 = q('[data-l1]');
    const station = q('[data-station]');
    const target = q('[data-target]');
    const clock = q('[data-clock]');
    const delay = q('[data-delay]');
    const head = q('[data-head]');
    const tail = q('[data-tail]');
    let timer = 0;
    let last = '';

    function render() {
      const s = state(performance.now());
      // il widget Android non anima: si aggiorna a scatti, non a ogni secondo
      const key = `${s.idx}|${s.moving}|${Math.floor(s.eta / 5)}|${s.delay}`;
      if (key === last) return;
      last = key;
      l1.textContent = `${TRAIN_NUMBER} · ${s.arrived ? 'Arrivato a' : s.moving ? 'In transito' : 'Fermo a'}`;
      station.textContent = fit(STOPS[s.idx].name);
      target.textContent = `→ ${fit(DEST.name)} · ${s.eta}'`;
      clock.textContent = s.clock;
      delay.textContent = s.delay > 0 ? `+${s.delay}'` : "0'";
      delay.classList.toggle('ok', s.delay <= 0);
      head.hidden = !s.moving;
      tail.hidden = s.moving;
    }

    render();
    if (reducedMotion()) return;
    new IntersectionObserver((e) => {
      window.clearInterval(timer);
      timer = e[0].isIntersecting ? window.setInterval(render, 500) : 0;
    }).observe(root);
  });
</script>
