---
// Il Nothing Phone (3) di Hevy Companion con la Glyph accesa: un allenamento già pronto (quattro esercizi di fila,
// ognuno con il set, le ripetizioni dello stickman e il riposo con la sabbia) che gira da solo. Tre soli bottoni:
// esercizio precedente, pausa, esercizio successivo. I fotogrammi sono quelli veri dell'app.
import GlyphMockup from './GlyphMockup.astro';
---

<figure class="phone-fig" data-glyph-phone>
  <GlyphMockup zoomed />
  <figcaption>
    <p class="now mono" data-now aria-live="off">&nbsp;</p>
    <div class="ctl mono" role="group" aria-label="Allenamento">
      <button type="button" data-prev aria-label="Esercizio precedente">‹ prec.</button>
      <button type="button" data-pause aria-pressed="false">pausa</button>
      <button type="button" data-next aria-label="Esercizio successivo">succ. ›</button>
    </div>
    <p class="count mono" data-count>1 / 4</p>
  </figcaption>
</figure>

<style>
  .phone-fig {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin: 0;
    padding: clamp(24px, 4vw, 48px) 16px 22px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background:
      radial-gradient(60% 70% at 50% 40%, var(--bg-3), transparent 80%),
      var(--bg-2);
  }
  figcaption {
    display: grid;
    justify-items: center;
    gap: 12px;
    width: 100%;
  }
  .ctl {
    display: flex;
    gap: 8px;
  }
  .ctl button {
    min-width: 84px;
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    border-radius: 99px;
    background: transparent;
    color: var(--fg-2);
    font-size: 12px;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .ctl button:hover {
    color: var(--fg);
    border-color: var(--fg-3);
  }
  .ctl button[aria-pressed='true'] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .ctl button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .now,
  .count {
    margin: 0;
    font-size: 12.5px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .now {
    min-height: 1.5em;
    color: var(--fg-2);
    text-align: center;
  }
  .count {
    font-size: 11.5px;
  }
</style>

<script>
  import { cycleFrame, cycleLength, drawMatrix, loadAnims, reducedMotion, type Anim, type Phase } from '../scripts/glyph';

  const WORKOUT = ['bench press', 'cable fly', 'squat', 'lat pulldown'];
  const REST_MS = 10_000; // riposo corto, così in pochi secondi si vede tutto
  const PHASE_TEXT: Record<Phase, string> = {
    set: 'set e peso',
    motion: 'lo stickman fa la ripetizione',
    rest: 'riposo: la sabbia sale, i secondi al centro',
    next: 'riposo: i dati del prossimo set sulla sabbia',
    alert: 'fine del riposo',
  };

  document.querySelectorAll<HTMLElement>('[data-glyph-phone]').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const now = root.querySelector<HTMLElement>('[data-now]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const btnPrev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const btnNext = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const btnPause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const still = reducedMotion();

    let list: Anim[] = [];
    let i = 0;
    let elapsed = 0;
    let last: number | null = null;
    let paused = still;
    let visible = false;
    let raf = 0;

    function paint() {
      const a = list[i];
      if (!a) return;
      const { frame, phase } = cycleFrame(a, elapsed, REST_MS);
      drawMatrix(ctx, frame, 0, 0, canvas.width);
      const line = `${a.label} · ${PHASE_TEXT[phase]}`;
      if (now.textContent !== line) now.textContent = line;
    }
    function go(n: number) {
      i = (n + list.length) % list.length;
      elapsed = 0;
      last = null;
      count.textContent = `${i + 1} / ${list.length}`;
      paint();
      kick();
    }
    function loop(t: number) {
      raf = 0;
      if (last !== null && !paused) elapsed += t - last;
      last = t;
      if (list[i] && elapsed >= cycleLength(list[i], REST_MS)) return go(i + 1); // passa all'esercizio dopo
      paint();
      if (visible && !paused) raf = requestAnimationFrame(loop);
    }
    function kick() {
      if (!raf && visible && !paused) raf = requestAnimationFrame(loop);
    }
    function setPaused(p: boolean) {
      paused = p;
      last = null;
      btnPause.textContent = p ? 'riproduci' : 'pausa';
      btnPause.setAttribute('aria-pressed', String(p));
      kick();
    }

    btnPrev.addEventListener('click', () => go(i - 1));
    btnNext.addEventListener('click', () => go(i + 1));
    btnPause.addEventListener('click', () => setPaused(!paused));
    if (still) setPaused(true);

    new IntersectionObserver((e) => {
      visible = e[0].isIntersecting;
      if (!visible) return;
      loadAnims().then((all) => {
        if (!list.length) {
          list = WORKOUT.map((id) => all.find((a) => a.id === id)).filter((a): a is Anim => !!a);
          if (!list.length) return;
          go(0);
        }
        last = null;
        kick();
      });
    }).observe(root);
  });
</script>
