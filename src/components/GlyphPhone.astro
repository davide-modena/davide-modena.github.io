---
// Il Nothing Phone (3) su un pavimento da palestra (bianco col tema chiaro, nero col tema scuro); la Glyph in
// alto a destra gira i fotogrammi veri dell'app. Il <canvas> sta sopra il cerchio del vetro: posizione e
// inclinazione (--tilt) sono misurate sul ritaglio 700×467 (x 280, y 202) dei mockup 1264×843.
import light from '../assets/mockup/phone-light.webp';
import dark from '../assets/mockup/phone-dark.webp';
---

<figure class="phone-fig" data-glyph-phone>
  <div class="phone">
    <img class="img-light" src={light.src} width={light.width} height={light.height} alt="Nothing Phone (3) bianco appoggiato su un pavimento da palestra, con la Glyph accesa" loading="lazy" decoding="async" />
    <img class="img-dark" src={dark.src} width={dark.width} height={dark.height} alt="Nothing Phone (3) nero appoggiato su un pavimento da palestra, con la Glyph accesa" loading="lazy" decoding="async" />
    <canvas width="160" height="160" aria-hidden="true"></canvas>
  </div>
  <figcaption>
    <div class="row">
      <span class="lbl mono">esercizio</span>
      <div class="chips mono" role="group" aria-label="Esercizio" data-chips></div>
    </div>
    <div class="row">
      <span class="lbl mono">riposo</span>
      <div class="chips mono" role="group" aria-label="Durata del riposo" data-timer></div>
    </div>
    <p class="now mono" data-now aria-live="off">&nbsp;</p>
  </figcaption>
</figure>

<style>
  .phone-fig {
    display: grid;
    justify-items: center;
    gap: 18px;
    margin: 0;
    padding: clamp(24px, 4vw, 48px) 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background:
      radial-gradient(60% 70% at 50% 40%, var(--bg-3), transparent 80%),
      var(--bg-2);
  }
  .phone {
    position: relative;
    width: min(860px, 100%);
    aspect-ratio: 700 / 467;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 50px rgb(0 0 0 / 0.3);
  }
  .phone img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .img-light {
    display: none;
  }
  :global(:root[data-theme='light']) .img-light {
    display: block;
  }
  :global(:root[data-theme='light']) .img-dark {
    display: none;
  }
  canvas {
    position: absolute;
    left: 62.29%;
    top: 27.4%;
    width: 5.9%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotate(21deg) scaleY(0.97);
    border-radius: 50%;
  }
  figcaption {
    display: grid;
    justify-items: center;
    gap: 10px;
    width: 100%;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 10px;
  }
  .lbl {
    min-width: 6.5ch;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    max-width: 62ch;
  }
  .chips :global(button) {
    padding: 5px 10px;
    border: 1px solid var(--line-2);
    border-radius: 99px;
    background: transparent;
    color: var(--fg-2);
    font-size: 12px;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .chips :global(button:hover) {
    color: var(--fg);
    border-color: var(--fg-3);
  }
  .chips :global(button[aria-pressed='true']) {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .chips :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .now {
    margin: 0;
    min-height: 1.5em;
    font-size: 12.5px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { cycleFrame, drawMatrix, loadAnims, reducedMotion, restStart, type Anim, type Phase } from '../scripts/glyph';

  const TIMERS = [10, 30, 60, 90]; // secondi di riposo; il conto va in tempo reale

  const FAVOURITES = [
    'bench press', 'cable fly', 'dumbbell curl', 'crunch machine', 'shoulder press', 'lateral raise',
    'triceps pushdown', 'skullcrusher', 'leg press', 'lat pulldown', 'iso-lateral row', 'deadlift', 'squat',
  ];
  const PHASE_TEXT: Record<Phase, string> = {
    set: 'set e peso',
    motion: 'lo stickman fa la ripetizione',
    rest: 'riposo: la sabbia sale, i secondi a centro',
    next: 'riposo: i dati del prossimo set sulla sabbia',
    alert: 'fine del riposo',
  };

  document.querySelectorAll<HTMLElement>('[data-glyph-phone]').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const chips = root.querySelector<HTMLElement>('[data-chips]')!;
    const timerEl = root.querySelector<HTMLElement>('[data-timer]')!;
    const nowEl = root.querySelector<HTMLElement>('[data-now]')!;
    let restMs = 30_000;
    let anims: Anim[] = [];
    let current: Anim | null = null;
    let t0 = performance.now();
    let visible = false;
    let raf = 0;
    let lastKey = '';
    const still = reducedMotion();

    function paint(ms: number) {
      if (!current) return;
      const { frame, phase } = cycleFrame(current, ms, restMs);
      drawMatrix(ctx, frame, 0, 0, canvas.width);
      if (nowEl.dataset.p !== phase) {
        nowEl.dataset.p = phase;
        nowEl.textContent = `${current.label} · ${PHASE_TEXT[phase]}`;
      }
    }
    function loop(now: number) {
      raf = 0;
      const ms = now - t0;
      const key = String(Math.floor(ms / 50));
      if (key !== lastKey) {
        lastKey = key;
        paint(ms);
      }
      if (visible && !still) raf = requestAnimationFrame(loop);
    }
    function kick() {
      if (!raf && visible) raf = requestAnimationFrame(loop);
    }

    function setTimer(sec: number) {
      restMs = sec * 1000;
      timerEl.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.sec) === sec)));
      if (current) {
        // riparte da quando comincia il riposo, così si vede subito la sabbia
        t0 = performance.now() - restStart(current);
        lastKey = '';
        nowEl.dataset.p = '';
        paint(restStart(current));
        kick();
      }
    }
    TIMERS.forEach((sec) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.dataset.sec = String(sec);
      b.textContent = `${sec} s`;
      b.setAttribute('aria-pressed', String(sec * 1000 === restMs));
      b.addEventListener('click', () => setTimer(sec));
      timerEl.appendChild(b);
    });

    function pick(a: Anim) {
      current = a;
      t0 = performance.now();
      lastKey = '';
      nowEl.dataset.p = '';
      chips.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === a.id)));
      paint(0);
      kick();
    }

    new IntersectionObserver((e) => {
      visible = e[0].isIntersecting;
      if (visible) {
        loadAnims().then((a) => {
          if (!anims.length) {
            anims = [...a].sort((x, y) => {
              const ix = FAVOURITES.indexOf(x.id);
              const iy = FAVOURITES.indexOf(y.id);
              return (ix < 0 ? 99 : ix) - (iy < 0 ? 99 : iy);
            });
            anims.forEach((x) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.dataset.id = x.id;
              b.textContent = x.label;
              b.setAttribute('aria-pressed', 'false');
              b.addEventListener('click', () => pick(x));
              chips.appendChild(b);
            });
            pick(anims[0]);
          }
          kick();
        });
      }
    }).observe(root);
  });
</script>
