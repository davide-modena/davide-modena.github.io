---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shot: ImageMetadata;
  alt: string;
}
const { shot, alt } = Astro.props;
---

<div class="phone">
  <div class="screen" data-scrub-vp>
    <Image src={shot} alt={alt} widths={[400, 600]} sizes="240px" loading="lazy" data-scrub-img />
    <span class="island" aria-hidden="true"></span>
  </div>
</div>

<style>
  .phone {
    padding: 7px;
    border-radius: 34px;
    background: #0d0d0d;
    border: 1px solid var(--line-2);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.04) inset,
      0 40px 80px -24px rgb(0 0 0 / 0.7);
  }
  .screen {
    position: relative;
    aspect-ratio: 9 / 19.5;
    border-radius: 27px;
    overflow: hidden;
    background: #000;
  }
  .screen img {
    width: 100%;
    will-change: transform;
  }
  .island {
    position: absolute;
    top: 7px;
    left: 50%;
    translate: -50% 0;
    width: 30%;
    height: 16px;
    border-radius: 99px;
    background: #000;
  }
</style>
