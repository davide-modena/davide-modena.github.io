---
// Copertina generata per i progetti senza immagine: una matrice di punti
// il cui disegno dipende dal tipo di progetto e dallo slug (sempre uguale per lo stesso progetto).
interface Props {
  seed: string;
  kind: 'web' | 'app' | 'bot' | 'hardware' | 'tool';
  glyph: string;
  /** colonne della griglia: di più per le copertine grandi */
  cols?: number;
}
const { seed, kind, glyph, cols = 32 } = Astro.props;

function hash(s: string) {
  let h = 2166136261;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return (h >>> 0) / 4294967295;
}
const r = hash(seed);
const r2 = hash(seed + '#');
const COLS = cols;
const ROWS = Math.round((cols * 9) / 16);
const cx = 0.25 + r * 0.5;
const cy = 0.3 + r2 * 0.4;

const field: Record<Props['kind'], (x: number, y: number) => number> = {
  // cerchi concentrici che partono da un punto
  app: (x, y) => 0.5 + 0.5 * Math.cos(Math.hypot(x - cx, (y - cy) * 0.56) * (22 + r * 14)),
  // onde orizzontali
  web: (x, y) => 0.5 + 0.5 * Math.sin(x * (8 + r * 8) + Math.sin(y * 5 + r2 * 6) * 2.4),
  // griglia a blocchi, tipo circuito
  hardware: (x, y) => {
    const gx = Math.floor(x * 8 + r * 3);
    const gy = Math.floor(y * 5 + r2 * 3);
    return hash(`${seed}${gx}.${gy}`) > 0.55 ? 0.9 : 0.12 + 0.5 * Math.abs(Math.sin((x + y) * 20));
  },
  // diagonali
  tool: (x, y) => 0.5 + 0.5 * Math.sin((x * (1 + r) + y * 0.6) * 18 + r2 * 10),
  bot: (x, y) => 0.5 + 0.5 * Math.sin(x * 14) * Math.cos(y * 9 + r * 5),
};

const f = field[kind];
const dots: { x: number; y: number; s: number }[] = [];
for (let j = 0; j < ROWS; j++) {
  for (let i = 0; i < COLS; i++) {
    const x = i / (COLS - 1);
    const y = j / (ROWS - 1);
    // sfuma verso il basso a sinistra, dove sta il simbolo
    const fade = Math.min(1, Math.hypot(x - 0.08, y - 0.86) * 1.6);
    const v = f(x, y) * fade;
    dots.push({ x: i * 10 + 5, y: j * 10 + 5, s: Math.round(v * 100) / 100 });
  }
}
---

<div class="cover" aria-hidden="true">
  <svg viewBox={`0 0 ${COLS * 10} ${ROWS * 10}`} preserveAspectRatio="xMidYMid slice">
    {dots.map((d) => <circle cx={d.x} cy={d.y} r={0.6 + d.s * 2.6} style={`--o:${(0.12 + d.s * 0.88).toFixed(2)}`} />)}
  </svg>
  <span class="glyph">{glyph}</span>
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }
  svg {
    width: 100%;
    height: 100%;
    transition: transform 1.2s var(--ease);
  }
  circle {
    fill: var(--fg-3);
    opacity: var(--o);
    transition: fill 0.5s var(--ease);
  }
  .glyph {
    position: absolute;
    left: 18px;
    bottom: 12px;
    font-size: 34px;
    line-height: 1;
    color: var(--fg);
    transition:
      color 0.4s,
      transform 0.6s var(--ease);
  }
  :global(.lab-card:hover) circle,
  :global(.lab-card.kb-active) circle {
    fill: var(--accent);
  }
  :global(.lab-card:hover) svg {
    transform: scale(1.06);
  }
  :global(.lab-card:hover) .glyph {
    color: var(--accent);
    transform: rotate(-8deg);
  }
</style>
