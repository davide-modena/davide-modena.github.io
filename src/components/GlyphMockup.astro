---
// Il Nothing Phone (3) su un pavimento da palestra (bianco col tema chiaro, nero col tema scuro), con un <canvas>
// sopra il cerchio della Glyph: chi lo usa ci disegna i fotogrammi. Posizione e inclinazione sono misurate
// sul ritaglio 700×467 (x 280, y 202) dei mockup 1264×843; su telefono si usa la foto più vicina.
import light from '../assets/mockup/phone-light.webp';
import dark from '../assets/mockup/phone-dark.webp';
// su telefono: foto più vicina, tagliata in basso, sul solo pavimento (scripts/phone-mobile.mjs)
import mLight from '../assets/mockup/phone-m-light.webp';
import mDark from '../assets/mockup/phone-m-dark.webp';
import floor from '../assets/mockup/floor.webp';

interface Props {
  /** la foto ravvicinata del telefono (quella da cellulare) anche su schermi larghi */
  zoomed?: boolean;
}
const { zoomed = false } = Astro.props;
---

  <div class:list={['phone', { zoomed }]} style={`--floor: url(${floor.src})`}>
    <img class="img-light" src={light.src} width={light.width} height={light.height} alt="Nothing Phone (3) bianco appoggiato su un pavimento da palestra, con la Glyph accesa" loading="lazy" decoding="async" />
    <img class="img-dark" src={dark.src} width={dark.width} height={dark.height} alt="Nothing Phone (3) nero appoggiato su un pavimento da palestra, con la Glyph accesa" loading="lazy" decoding="async" />
    <img class="m-light" src={mLight.src} width={mLight.width} height={mLight.height} alt="" loading="lazy" decoding="async" />
    <img class="m-dark" src={mDark.src} width={mDark.width} height={mDark.height} alt="" loading="lazy" decoding="async" />
    <canvas width="160" height="160" aria-hidden="true"></canvas>
  </div>

<style>
  .phone {
    position: relative;
    width: min(860px, 100%);
    aspect-ratio: 700 / 467;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 24px 50px rgb(0 0 0 / 0.3);
  }
  .phone img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;    /* niente bordo né angoli arrotondati: li aggiungerebbe lo stile generale delle immagini degli articoli */
    border: 0;
    border-radius: 0;
  }
  .img-light {
    display: none;
  }
  :global(:root[data-theme='light']) .img-light {
    display: block;
  }
  :global(:root[data-theme='light']) .img-dark {
    display: none;
  }
  .m-light,
  .m-dark {
    display: none;
  }
  canvas {
    position: absolute;
    left: 62.29%;
    top: 27.4%;
    width: 5.9%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) rotate(21deg) scaleY(0.97);
    border-radius: 50%;
  }
  /* telefono: il telefono è grande e tagliato in basso (si vedono fotocamere e Glyph) sulla texture del pavimento */
  @media (max-width: 700px) {
    .phone {
      width: 100%;
      aspect-ratio: 1 / 1;
      background:
        radial-gradient(ellipse 80% 70% at 50% 40%, transparent 40%, rgb(0 0 0 / 0.55) 100%),
        var(--floor) center / cover,
        #141414;
    }
    .phone .img-light,
    .phone .img-dark {
      display: none;
    }
    .phone .m-dark {
      display: block;
    }
    :global(:root[data-theme='light']) .phone .m-light {
      display: block;
    }
    :global(:root[data-theme='light']) .phone .m-dark {
      display: none;
    }
    .phone .m-light,
    .phone .m-dark {
      inset: auto;
      left: 7%;
      top: 9%;
      width: 86%;
      max-width: none;
      height: auto;
      object-fit: fill;
    }
    canvas {
      left: 75.4%;
      top: 26.6%;
      width: 22.5%;
      transform: translate(-50%, -50%);
    }
  }

  /* foto ravvicinata anche su schermi larghi (es. il Glyph Toy di Trenitardo) */
  .phone.zoomed {
    width: min(100%, 460px);
    aspect-ratio: 1 / 1;
    background:
      radial-gradient(ellipse 80% 70% at 50% 40%, transparent 40%, rgb(0 0 0 / 0.55) 100%),
      var(--floor) center / cover,
      #141414;
  }
  .phone.zoomed .img-light,
  .phone.zoomed .img-dark {
    display: none;
  }
  .phone.zoomed .m-dark {
    display: block;
  }
  :global(:root[data-theme='light']) .phone.zoomed .m-light {
    display: block;
  }
  :global(:root[data-theme='light']) .phone.zoomed .m-dark {
    display: none;
  }
  .phone.zoomed .m-light,
  .phone.zoomed .m-dark {
    inset: auto;
    left: 7%;
    top: 9%;
    width: 86%;
    max-width: none;
    height: auto;
    object-fit: fill;
  }
  .zoomed canvas {
    left: 75.4%;
    top: 26.6%;
    width: 22.5%;
    transform: translate(-50%, -50%);
  }
</style>
