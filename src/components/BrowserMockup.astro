---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shot: ImageMetadata;
  domain: string;
  alt: string;
  eager?: boolean;
}
// La pagina dentro la finestra la fa scorrere scripts/scrub.ts, in base allo scroll della pagina.
const { shot, domain, alt, eager = false } = Astro.props;
---

<div class="browser">
  <div class="chrome">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="url mono">
      <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
        <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
      {domain}
    </span>
    <span aria-hidden="true"></span>
  </div>
  <div class="viewport" data-scrub-vp>
    <Image src={shot} alt={alt} widths={[800, 1200]} sizes="(max-width: 900px) 100vw, 60vw" loading={eager ? 'eager' : 'lazy'} data-scrub-img />
  </div>
</div>

<style>
  .browser {
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: var(--shadow);
  }
  .chrome {
    display: grid;
    grid-template-columns: 60px 1fr 60px;
    align-items: center;
    height: 34px;
    padding: 0 12px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-3);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .url {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--fg-3);
    padding: 3px 14px;
    border-radius: 6px;
    background: var(--bg-2);
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
  }
  .viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg);
  }
  .viewport img {
    width: 100%;
    will-change: transform;
  }
</style>
