---
import Portrait from './Portrait.astro';
import { useTranslations, path } from '../i18n/utils';
import { contact, location } from '../data/profile';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" data-section="~">
  <div class="frame grid">
    <div class="copy">
      <p class="avail mono" data-reveal>
        <span class="dot"></span>
        {t('hero.available')}
      </p>

      <h1 aria-label="Davide Modena">
        <span class="line"><span data-scramble>Davide</span></span>
        <span class="line"><span data-scramble>Modena</span><span class="accent">.</span></span>
      </h1>

      <p class="typed mono" data-reveal style="--d:.15s">
        <span class="gt">&gt;</span>
        <span>{t('hero.typed.prefix')}</span>
        <span class="word" data-words={t('hero.typed')}>{t('hero.typed').split('|')[0]}</span><span class="caret"
        ></span>
      </p>

      <p class="lead" data-reveal style="--d:.25s">{t('hero.lead')}</p>

      <div class="ctas" data-reveal style="--d:.35s">
        <a href={path('contact', lang)} class="btn btn-primary">{t('hero.cta.primary')} <span class="arrow">→</span></a>
        <a href={contact.linkedin} class="btn up" target="_blank" rel="noopener"
          >{t('hero.cta.secondary')} <span class="arrow">↗</span></a
        >
      </div>
    </div>

    <div class="photo" data-reveal style="--d:.2s">
      <Portrait eager />
    </div>
  </div>

  <div class="frame meta mono">
    <span>{t('hero.kicker')}</span>
    <span class="hide-s">{location.coords}</span>
    <span class="hide-s">{t('hero.localtime')} <b data-clock>--:--:--</b></span>
    <a href="#lavori" class="scroll">{t('hero.scroll')} <span class="bounce">↓</span></a>
  </div>
</section>

<script>
  // ora locale di Trento
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('it-IT', { timeZone: 'Europe/Rome', hour: '2-digit', minute: '2-digit', second: '2-digit' });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 1000);
  }

  // macchina da scrivere: scrive, aspetta, cancella, passa alla parola dopo
  const el = document.querySelector<HTMLElement>('.hero .word');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = el.dataset.words!.split('|');
    let w = 0;
    let i = words[0].length;
    let deleting = false;
    const step = () => {
      const word = words[w];
      if (!deleting) {
        i++;
        el.textContent = word.slice(0, i);
        if (i >= word.length) {
          deleting = true;
          return setTimeout(step, 2200);
        }
        return setTimeout(step, 55 + Math.random() * 70);
      }
      i--;
      el.textContent = word.slice(0, i);
      if (i <= 0) {
        deleting = false;
        w = (w + 1) % words.length;
        return setTimeout(step, 300);
      }
      setTimeout(step, 28);
    };
    setTimeout(() => {
      deleting = true;
      step();
    }, 2600);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h) - var(--status-h));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: clamp(40px, 8vh, 96px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--fg-2);
    padding: 7px 12px 7px 10px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
  }
  h1 {
    font-size: clamp(64px, 11.5vw, 176px);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.86;
    margin: 28px 0 32px;
    margin-left: -0.05em;
  }
  h1 .line {
    display: block;
    white-space: nowrap;
  }
  .accent {
    color: var(--accent);
  }
  .typed {
    font-size: clamp(15px, 1.6vw, 19px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 10px;
    min-height: 1.6em;
  }
  .gt {
    color: var(--accent);
  }
  .word {
    color: var(--fg);
    background: var(--accent-soft);
    padding: 0 4px;
    border-radius: 3px;
    margin-right: -6px;
  }
  .word:empty {
    padding: 0;
  }
  .caret {
    width: 0.55em;
    height: 1.15em;
    background: var(--accent);
    margin-left: 6px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .lead {
    margin-top: 28px;
    max-width: 44ch;
    color: var(--fg-2);
    font-size: clamp(16px, 1.35vw, 18.5px);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
  }

  .photo {
    display: grid;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 18px;
    padding-bottom: 22px;
    font-size: 11.5px;
    color: var(--fg-3);
    border-top: 1px solid var(--line);
  }
  .meta b {
    color: var(--fg-2);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }
  .scroll:hover {
    color: var(--fg);
  }
  .bounce {
    display: inline-block;
    animation: bounce 1.8s var(--ease) infinite;
  }
  @keyframes bounce {
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 320px;
      width: 100%;
      margin-inline: auto;
    }
    .hide-s {
      display: none;
    }
  }
</style>
