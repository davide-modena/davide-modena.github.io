---
// Galleria delle scene low poly della hero "Sobria" di Trenitardo (src/components/sober/).
import Galleria from './sober/Galleria.jsx';
---

<figure class="sg">
  <Galleria />
  <figcaption class="mono">Le scene della hero: la striscia sceglie quelle delle fermate che il treno sta attraversando.</figcaption>
</figure>

<style>
  .sg {
    margin: 0;
  }
  .sg :global(.sgal) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 10px;
  }
  .sg :global(.sgal li) {
    margin: 0;
    padding: 0;
  }
  .sg :global(.sgal li::before) {
    content: none;
  }
  .sg :global(.scena) {
    border: 1px solid var(--line-2);
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(180deg, #cfe6f5 0%, #e9f3fa 65%, #f7fafc 100%);
  }
  :global(:root:not([data-theme='light'])) .sg :global(.scena) {
    background: linear-gradient(180deg, #0f1a2b 0%, #1a2638 65%, #232c38 100%);
  }
  :global(:root:not([data-theme='light'])) .sg :global(.scena svg) {
    filter: brightness(0.48) saturate(0.75) hue-rotate(-8deg);
  }
  .sg :global(.scena svg) {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
    border: 0;
  }
  .sg :global(.sgal p) {
    margin: 6px 2px 0;
    font-size: 13px;
    line-height: 1.3;
  }
  .sg :global(.sgal p span) {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fg-3);
  }
  figcaption {
    margin-top: 12px;
    font-size: 12px;
    color: var(--fg-3);
  }
</style>
