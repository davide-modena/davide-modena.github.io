---
import View from '../../../views/BlogPostView.astro';
import { getBlog } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getBlog();
  return posts.filter((p) => p.data.lang === 'en').map((p) => ({ params: { slug: p.slug } }));
}
---

<View lang="en" slug={Astro.params.slug} />
