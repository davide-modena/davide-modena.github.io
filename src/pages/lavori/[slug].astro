---
import View from '../../views/DetailView.astro';
import { getLocalized } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getLocalized('works', 'it');
  return entries.map((e) => ({ params: { slug: e.slug } }));
}
---

<View lang="it" kind="works" slug={Astro.params.slug} />
