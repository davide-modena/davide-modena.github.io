---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import StatusBar from '../components/StatusBar.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Terminal from '../components/Terminal.astro';
import KeysDialog from '../components/KeysDialog.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** URL della stessa pagina nell'altra lingua */
  alternate: string;
  title?: string;
  description?: string;
  /** percorso mostrato nella barra di stato finché non si scorre su una sezione */
  path?: string;
  /** il grande "Parliamone." in fondo; sulla pagina contatti resta solo il piè di pagina */
  contactCta?: boolean;
}

const { lang, alternate, title, description, path = '~', contactCta = true } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} — Davide Modena` : t('meta.title');
const desc = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const altLang = lang === 'it' ? 'en' : 'it';
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={altLang} href={new URL(alternate, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <script is:inline>
      // tema prima del primo paint, per non avere il lampo bianco/nero
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        var saved = null;
        var accent = null;
        try {
          saved = localStorage.getItem('theme');
          accent = localStorage.getItem('accent');
        } catch (e) {}
        d.dataset.theme = saved === 'light' ? 'light' : 'dark';
        if (accent === 'blue' || accent === 'azure') d.dataset.accent = accent;
      })();
    </script>
  </head>
  <body>
    <div class="guides" aria-hidden="true"><div class="frame"></div></div>
    <Header lang={lang} alternate={alternate} />
    <main id="top">
      <slot />
      <Contact lang={lang} compact={!contactCta} />
    </main>
    <StatusBar path={path} />
    <CommandPalette lang={lang} alternate={alternate} />
    <Terminal lang={lang} alternate={alternate} />
    <KeysDialog lang={lang} />
    <div class="toast mono" role="status" aria-live="polite"></div>

    <script>
      import '../scripts/reveal';
      import '../scripts/scramble';
      import '../scripts/theme';
      import '../scripts/keys';
      import '../scripts/toast';
      import '../scripts/scrub';
    </script>
  </body>
</html>

<style is:global>
  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(var(--status-h) + 20px);
    translate: -50% 16px;
    z-index: 90;
    padding: 10px 14px;
    font-size: 12.5px;
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      translate 0.3s var(--ease);
  }
  .toast.show {
    opacity: 1;
    translate: -50% 0;
  }
</style>
